# .husky/pre-commit

# Deny-by-default guard: block the commit if any server/api endpoint is missing
# defineAuthedHandler. Fast, whole-repo invariant — runs first, fails fast.
node scripts/check-endpoint-auth.mjs || exit 1

# i18n guardrail: en/es key parity, no empty values, all $t() keys defined.
node scripts/i18n-check.js || exit 1

npx eslint $(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g')
prettier $(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g') --write --ignore-unknown
git update-index --again
